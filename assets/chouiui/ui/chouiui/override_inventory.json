{
  "namespace": "crafting",
  "chouiui_inventory_content": {
    "type": "panel",
    "controls": [
      {
        "content_stack_panel": {
          "type": "stack_panel",
          "size": [
            326,
            166
          ],
          "orientation": "horizontal",
          "controls": [
            {
              "survival_pad": {
                "type": "panel",
                "size": [
                  75,
                  "100%"
                ],
                "bindings": [
                  {
                    "binding_type": "global",
                    "binding_name": "(not #is_creative_layout)",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "java_inventory@chouiui.java_inventory_panel": {
                "layer": 2,
                "bindings": [
                  {
                    "binding_type": "global",
                    "binding_name": "(not #is_creative_layout)",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "creative_root": {
          "type": "panel",
          "size": [
            "100%",
            "100%"
          ],
          "bindings": [
            {
              "binding_type": "global",
              "binding_name": "#is_creative_layout",
              "binding_name_override": "#visible"
            }
          ],
          "controls": [
            {
              "creative_default@crafting.recipe_book": {
                "size": [
                  326,
                  166
                ],
                "anchor_from": "center",
                "anchor_to": "center",
                "layer": 1
              }
            },
            {
              "creative_minimal": {
                "type": "panel",
                "size": [
                  "100%",
                  "100%"
                ],
                "layer": 12,
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "h_toggle",
                    "source_property_name": "#toggle_state",
                    "target_property_name": "#visible",
                    "resolve_sibling_scope": true
                  }
                ],
                "controls": [
                  {
                    "minimal_bg": {
                      "type": "image",
                      "texture": "textures/ui/dialog_background_opaque",
                      "size": [
                        "100%",
                        "100%"
                      ],
                      "nineslice": 8,
                      "layer": 0
                    }
                  },
                  {
                    "minimal_java@chouiui.java_inventory_panel_creative": {
                      "layer": 2,
                      "anchor_from": "center",
                      "anchor_to": "center"
                    }
                  }
                ]
              }
            },
            {
              "h_toggle@chouiui.h_toggle": {
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "offset": [
                  -16,
                  3
                ],
                "layer": 31
              }
            }
          ]
        }
      },
      {
        "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
      },
      {
        "inventory_selected_icon_button@common.inventory_selected_icon_button": {}
      },
      {
        "hold_icon@common.inventory_take_progress_icon_button": {}
      },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {}
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {}
      },
      {
        "flying_item_renderer@common.flying_item_renderer": {
          "layer": 15
        }
      }
    ]
  },
  "chouiui_crafting_content": {
    "type": "panel",
    "controls": [
      {
        "content_stack_panel": {
          "type": "stack_panel",
          "size": [
            326,
            166
          ],
          "orientation": "horizontal",
          "controls": [
            {
              "survival_pad": {
                "type": "panel",
                "size": [
                  75,
                  "100%"
                ]
              }
            },
            {
              "java_crafting@chouiui.java_crafting_panel": {
                "layer": 2
              }
            }
          ]
        }
      },
      {
        "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
      },
      {
        "inventory_selected_icon_button@common.inventory_selected_icon_button": {}
      },
      {
        "hold_icon@common.inventory_take_progress_icon_button": {}
      },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {}
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {}
      },
      {
        "flying_item_renderer@common.flying_item_renderer": {
          "layer": 15
        }
      }
    ]
  },
  "inventory_screen@crafting.inventory_screen_base": {
    "send_telemetry": false,
    "$screen_content": "crafting.chouiui_inventory_content",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.75
  },
  "crafting_screen@crafting.inventory_screen_base": {
    "send_telemetry": false,
    "$uses_bundle_tooltip": true,
    "$screen_content": "crafting.chouiui_crafting_content",
    "$screen_bg_content": "common.screen_background",
    "$screen_background_alpha": 0.75,
    "$close_on_player_hurt": true
  }
}